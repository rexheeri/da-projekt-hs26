# Copy this file to .env (never commit .env).
#
# Database. Leave DATABASE_URL commented out to use SQLite (no setup needed).
# For PostgreSQL: start it with `docker compose up -d`, then uncomment:
# DATABASE_URL=postgresql://pgadmin:geheim@localhost:5432/postgres
#
# In GitHub Codespaces use the service name as host:
# DATABASE_URL=postgresql://pgadmin:geheim@db:5432/postgres

# PostgreSQL / pgAdmin credentials used by docker-compose.yml (local only)
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=geheim
POSTGRES_DB=postgres
